# LLM Configuration

LLM_PROVIDER=openrouter  # Options: ollama, openrouter

# adjust for local ollama:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3.5:9b-64k
# OLLAMA_TEMPERATURE=0.4  # generation temperature (0.0 = deterministic, 1.0 = creative)
# qwen3:8b quantized runs reasonbly fast even on a laptop with 16GB RAM and a decent CPU

# For openrouter generate and add your key. This model is free but you get rate limits.:
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-4.5-air:free

# Agent settings
KEEP_MESSAGES=7  # How many old messages to show as context
KEEP_FULL_OUTPUTS=2  # How many of those should include full tool output

# debugging stuff
VERBOSE=False  # Set to True for detailed tracing output by crewai library
LITELLM_LOG=CRITICAL # reduce litellm noise in terminal; set DEBUG for troubleshooting

# Memory
MEMORY_ENABLED=True
MEMORY_PATH=.crewai/chroma
MEMORY_COLLECTION=mlops_memories
MEMORY_RECALL_LIMIT=4

# ReAct mode (disable native function calling for Ollama compatibility)
FORCE_REACT=True

# Optional monitoring endpoints (Kind: NodePort 30090/30030, real cluster: adjust)
# PROMETHEUS_URL=http://localhost:30090
# GRAFANA_URL=http://localhost:30030
# GRAFANA_TOKEN=
